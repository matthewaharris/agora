{
  "name": "oacp",
  "version": "0.1.0",
  "private": true,
  "description": "Open Agent Communication Protocol — Open registry and communication layer for AI agent interoperability",
  "scripts": {
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:functions": "npx supabase functions serve --no-verify-jwt",
    "agent:research": "cd agents/research-agent && npm start",
    "agent:extraction": "cd agents/extraction-agent && npm start",
    "dashboard": "cd apps/dashboard && npx serve -s . -l 3000",
    "demo": "bash scripts/demo.sh",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "agents/*"
  ],
  "devDependencies": {
    "oacp-sdk": "^0.20.0"
  },
  "keywords": ["oacp", "agent", "protocol", "ai", "interoperability"],
  "license": "MIT"
}
