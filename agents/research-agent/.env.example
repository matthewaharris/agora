# Supabase project URL
SUPABASE_URL=http://localhost:54321
# Supabase anon key (from supabase start output)
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: OpenAI API key for real LLM summarization
# Without this, the agent uses built-in summaries (still works for demo)
OPENAI_API_KEY=
# Optional: Override the model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
